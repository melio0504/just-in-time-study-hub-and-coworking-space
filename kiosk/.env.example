# These public values are embedded into the static kiosk renderer at build time.
# Rebuild the Electron app after changing them. Never use a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Private device credential used only by the Electron main process. Generate at
# least 32 random characters and set the identical KIOSK_ACCESS_TOKEN as a
# Supabase Edge Function secret. Do not prefix this value with NEXT_PUBLIC_.
KIOSK_ACCESS_TOKEN=replace_with_at_least_32_random_characters
