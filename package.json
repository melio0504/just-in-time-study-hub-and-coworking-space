  "keywords": [
    "study hub",
    "coworking",
    "workspace",
    "booking",
    "kiosk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/melio0504/just-in-time-study-hub-and-coworking-space"
  },
  "bugs": {
    "url": "https://github.com/melio0504/just-in-time-study-hub-and-coworking-space/issues"
  },
  "homepage": "https://jit-studyhub.com",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "admin"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:frontend": "npm run dev --workspace @jit-studyhub/frontend",
    "dev:frontend:lan": "npm run dev:lan --workspace @jit-studyhub/frontend",
    "dev:admin": "npm run dev --workspace @jit-studyhub/admin",
    "dev:admin:https": "npm run dev:https --workspace @jit-studyhub/admin",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace @jit-studyhub/frontend",
    "build:admin": "npm run build --workspace @jit-studyhub/admin",
    "start:frontend": "npm run start --workspace @jit-studyhub/frontend",
    "start:frontend:lan": "npm run start:lan --workspace @jit-studyhub/frontend",
    "android:sync": "npm run android:sync --workspace @jit-studyhub/frontend",
    "android:open": "npm run android:open --workspace @jit-studyhub/frontend",
    "android:run": "npm run android:run --workspace @jit-studyhub/frontend",
    "start:admin": "npm run start --workspace @jit-studyhub/admin",
    "start:admin:lan": "npm run start:lan --workspace @jit-studyhub/admin",
    "lint": "npm run lint --workspaces --if-present",
    "supabase:start": "supabase start",
    "supabase:functions": "supabase functions serve",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > frontend/lib/supabase/database.types.ts && cp frontend/lib/supabase/database.types.ts admin/lib/supabase/database.types.ts"
  },
  "devDependencies": {
    "cloudflared": "^0.7.3",
    "supabase": "2.117.0"
  }
}
