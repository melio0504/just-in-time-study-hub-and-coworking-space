{
  "name": "just-in-time-study-hub-and-coworking-space",
  "version": "1.2.0",
  "private": true,
  "description": "A full-stack platform for Just In Time Study Hub and Coworking Space, featuring online seat reservations, customer self-service, staff administration, and QR-based kiosk check-ins.",
  "author": {
    "name": "Just in Time Study Hub Dev Team"
  },
  "contributors": [
    {
      "name": "Barquez, Rafael C.",
      "email": "423002037@ntc.edu.ph"
    },
    {
      "name": "De Vera, Jhan Nichol G.",
      "email": "423002008@ntc.edu.ph"
    },
    {
      "name": "Teodoro, Romelio C.",
      "email": "423002722@ntc.edu.ph"
    },
    {
      "name": "Rivera, Edmon Daniel C.",
      "email": "423002830@ntc.edu.ph"
    },
    {
      "name": "Ronquillo, Vincent Raiven",
      "email": "423003415@ntc.edu.ph"
    }
  ],
  "keywords": [
    "study hub",
    "coworking",
    "workspace",
    "booking",
    "kiosk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/melio0504/just-in-time-study-hub-and-coworking-space"
  },
  "bugs": {
    "url": "https://github.com/melio0504/just-in-time-study-hub-and-coworking-space/issues"
  },
  "homepage": "https://www.jit-studyhub.com",
  "workspaces": [
    "frontend",
    "admin",
    "kiosk"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "sh scripts/install-git-hooks.sh",
    "dev:frontend": "npm run dev --workspace @jit-studyhub/frontend",
    "dev:admin": "npm run dev --workspace @jit-studyhub/admin",
    "dev:kiosk": "npm run dev --workspace @jit-studyhub/kiosk",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace @jit-studyhub/frontend",
    "build:admin": "npm run build --workspace @jit-studyhub/admin",
    "build:kiosk": "npm run build --workspace @jit-studyhub/kiosk",
    "test": "npm run test:unit",
    "test:unit": "npm run test --workspaces --if-present",
    "test:frontend": "npm test --workspace @jit-studyhub/frontend",
    "test:admin": "npm test --workspace @jit-studyhub/admin",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:frontend": "playwright test --project=frontend",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:kiosk": "playwright test --project=kiosk",
    "test:e2e:ui": "playwright test --ui",
    "test:db": "supabase test db --local",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:db",
    "check": "npm run lint && npm run test:unit && npm run build",
    "start:frontend": "npm run start --workspace @jit-studyhub/frontend",
    "start:admin": "npm run start --workspace @jit-studyhub/admin",
    "start:kiosk": "npm run start --workspace @jit-studyhub/kiosk",
    "desktop:kiosk": "npm run desktop --workspace @jit-studyhub/kiosk",
    "dist:kiosk": "npm run dist --workspace @jit-studyhub/kiosk",
    "dist:kiosk:win": "npm run dist:win --workspace @jit-studyhub/kiosk",
    "dist:kiosk:linux": "npm run dist:linux --workspace @jit-studyhub/kiosk",
    "dist:kiosk:docker": "docker buildx build --platform=linux/amd64 --file=kiosk/Dockerfile --target=all-artifacts --secret=id=kiosk_env,src=kiosk/.env.local --output=type=local,dest=kiosk/dist-electron/docker .",
    "dist:kiosk:docker:win": "docker buildx build --platform=linux/amd64 --file=kiosk/Dockerfile --target=windows-artifacts --secret=id=kiosk_env,src=kiosk/.env.local --output=type=local,dest=kiosk/dist-electron/docker .",
    "dist:kiosk:docker:linux": "docker buildx build --platform=linux/amd64 --file=kiosk/Dockerfile --target=linux-artifacts --secret=id=kiosk_env,src=kiosk/.env.local --output=type=local,dest=kiosk/dist-electron/docker .",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "supabase:start": "supabase start",
    "supabase:functions": "supabase functions serve",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > frontend/lib/supabase/database.types.ts && cp frontend/lib/supabase/database.types.ts admin/lib/supabase/database.types.ts",
    "paymongo:tunnel": "cloudflared tunnel --url http://127.0.0.1:54321",
    "paymongo:test-url": "bash scripts/open-paymongo-test-url.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "supabase": "^2.121.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
