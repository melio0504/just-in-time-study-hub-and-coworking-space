{
  "name": "just-in-time-study-hub-and-coworking-space",
  "version": "1.1.0",
  "private": true,
  "description": "A web-based study hub platform developed as a capstone project, featuring an informational website, admin dashboard, and an interactive 3D virtual tour of the facility.",
  "author": {
    "name": "Just in Time Study Hub Dev Team"
  },
  "contributors": [
